# QuickBooks Online API Configuration
# Toggle QBO_USE_MOCK=true to run offline sandbox mode with zero external credentials needed.
QBO_USE_MOCK=true
QBO_ENVIRONMENT=sandbox
QBO_REALM_ID=9341452019482710
QBO_CLIENT_ID=your_intuit_client_id
QBO_CLIENT_SECRET=your_intuit_client_secret
QBO_ACCESS_TOKEN=your_oauth2_access_token
QBO_REFRESH_TOKEN=your_oauth2_refresh_token

# Storage Configuration
DATABASE_PATH=storage/qbo_invoicing.db
EXPORTS_DIR=storage/exports

# Default Invoicing Settings
DEFAULT_PAYMENT_TERMS_DAYS=30
DEFAULT_CURRENCY=USD
DEFAULT_TAX_CODE=TAX
DEFAULT_ITEM_REF=1
